VITE_WEBSOCKET_URL=ws://127.0.0.1:8081/ws
VITE_DISCORD_CLIENT_ID=
VITE_DISCORD_REDIRECT_URI=http://localhost:5173/login

# Optional own map index and FoW image provider. No official game server fallback.
VITE_MAPS_URL=/maps.json
VITE_FROG_MAP_URL=
